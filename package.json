{
  "name": "@flurdy/pi-model-tier-router",
  "version": "0.1.0",
  "private": true,
  "description": "Provider-neutral semantic model-tier routing for Pi",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "model-routing"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "files": [
    "pi/model-tier-router/config.ts",
    "pi/model-tier-router/index.ts",
    "pi/model-tier-router/routing.ts",
    "pi/model-tier-router/usage-ledger.ts",
    "pi/model-tier-router/usage.ts",
    "pi/model-tier-router/README.md",
    "pi/model-tier-router/model-tier-router.example.json",
    "pi/model-tier-router/model-tier-router.opinionated.example.json"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test pi/model-tier-router/*.test.ts",
    "typecheck": "tsc --noEmit -p pi/model-tier-router/tsconfig.json",
    "check": "npm test && npm run typecheck && npm run pack:check",
    "pack:check": "node pi/model-tier-router/scripts/check-package.mjs",
    "verify:git-install": "pi/model-tier-router/scripts/verify-git-install.sh"
  },
  "pi": {
    "extensions": [
      "./pi/model-tier-router/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.82.1",
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
