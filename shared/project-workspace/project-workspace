def print_status_issues(
    label: str, status: str, issues: list[dict[str, object]]
) -> None:
    for issue in issues[:STATUS_ISSUE_LIMIT]:
        print(
            f"{label} | {status:<11} | P{issue['priority']} | "
            f"{issue['id']} | {issue['title']}"
        )
    if len(issues) > STATUS_ISSUE_LIMIT:
        print(f"{label} | … more {status} work omitted")


def beads_status(root: Path, manifest: dict[str, object]) -> bool:
    print("=== BEADS STATUS ===")
    success = True
    targets = status_targets(root, manifest)
    width = label_width(targets)
    for name, relative_path, directory in targets:
        label = f"{name} ({relative_path})".ljust(width)
        if not (directory / ".beads").is_dir():
            print(f"{label} | not initialized")
            continue
        active, active_error = load_status_issues(
            directory, ["--status=in_progress"]
        )
        ready, ready_error = load_status_issues(directory, ["--ready"])
        if active_error is not None or ready_error is not None:
            print(f"{label} | ERROR: {active_error or ready_error}")
            success = False
            continue
        if not active and not ready:
            print(f"{label} | no active or ready work")
            continue
        print_status_issues(label, "in_progress", active)
        print_status_issues(label, "ready", ready)
    print()
    return success


def status_workspace(root: Path, section: str) -> bool:
    workspace_root = Path(os.path.abspath(root.expanduser()))
    manifest, _readme = load_workspace_manifest(workspace_root)
    success = True
    if section in ("all", "git"):
        success = git_status(workspace_root, manifest) and success
    if section in ("all", "beads"):
        success = beads_status(workspace_root, manifest) and success
    return success


def run_sync_step(command: list[str], directory: Path) -> str | None:
    _result, error = run_repository_command(
        command, directory, timeout=SYNC_TIMEOUT_SECONDS
    )
    return error


def rebase_approved(label: str, upstream: str, assume_yes: bool) -> tuple[bool, str]:
    if assume_yes:
        return True, ""
    if not sys.stdin.isatty():
        return False, f"skipped (diverged from {upstream}; rerun with --yes)"
    answer = input(f"Rebase {label} onto {upstream}? [y/N] ").strip().lower()
    if answer in ("y", "yes"):
        return True, ""
    return False, f"skipped (rebase onto {upstream} declined)"


def push_repository(directory: Path, upstream: str, ahead: int) -> SyncOutcome:
    error = run_sync_step(["git", "push"], directory)
    if error is not None:
        return SyncOutcome(f"ERROR: push failed: {error}", failed=True)
    return SyncOutcome(f"pushed {ahead} to {upstream}")


def integrate_repository(
    directory: Path, label: str, status: GitStatus, dry_run: bool, assume_yes: bool
) -> SyncOutcome:
    upstream = status.upstream
    assert upstream is not None
    ahead, behind = status.ahead, status.behind
    assert ahead is not None and behind is not None
    if not ahead and not behind:
        return SyncOutcome(f"up to date with {upstream}")
    if not ahead:
        if dry_run:
            return SyncOutcome(f"would fast-forward {behind} from {upstream}")
        error = run_sync_step(["git", "merge", "--ff-only", upstream], directory)
        if error is not None:
            return SyncOutcome(
                f"ERROR: fast-forward failed: {error}", failed=True
            )
        return SyncOutcome(f"fast-forwarded {behind} from {upstream}")
    if not behind:
        if dry_run:
            return SyncOutcome(f"would push {ahead} to {upstream}")
        return push_repository(directory, upstream, ahead)
    if dry_run:
        return SyncOutcome(
            f"would rebase {ahead} onto {upstream} and push (behind {behind})"
        )
    approved, declined = rebase_approved(label, upstream, assume_yes)
    if not approved:
        return SyncOutcome(declined)
    error = run_sync_step(["git", "rebase", upstream], directory)
    if error is not None:
        run_sync_step(["git", "rebase", "--abort"], directory)
        return SyncOutcome(
            f"ERROR: rebase onto {upstream} was aborted: {error}", failed=True
        )
    pushed = push_repository(directory, upstream, ahead)
    if pushed.failed:
        return pushed
    return SyncOutcome(f"rebased onto {upstream} and pushed {ahead}")


def sync_repository(
    directory: Path, label: str, dry_run: bool, assume_yes: bool
) -> SyncOutcome:
    status, error = repository_git_status(directory)
    if error is not None:
        return SyncOutcome(f"ERROR: {error}", failed=True)
    assert status is not None
    if status.upstream is None:
        return SyncOutcome(f"skipped (branch {status.branch} has no upstream)")
    if status.dirty:
        return SyncOutcome(f"skipped (uncommitted changes: {status.dirty})")
    fetch_error = run_sync_step(["git", "fetch", "--quiet"], directory)
    if fetch_error is not None:
        return SyncOutcome(f"ERROR: fetch failed: {fetch_error}", failed=True)
    status, error = repository_git_status(directory)
    if error is not None:
        return SyncOutcome(f"ERROR: {error}", failed=True)
    assert status is not None
    if status.upstream is None or status.ahead is None or status.behind is None:
        return SyncOutcome(f"skipped (branch {status.branch} has no upstream)")
    return integrate_repository(directory, label, status, dry_run, assume_yes)


def sync_workspace(root: Path, dry_run: bool, assume_yes: bool) -> bool:
    workspace_root = Path(os.path.abspath(root.expanduser()))
    manifest, _readme = load_workspace_manifest(workspace_root)
    print("=== WORKSPACE SYNC ===")
    print("Scope: registered checkouts only; alternate worktrees are not synced.")
    success = True
    targets = status_targets(workspace_root, manifest)
    width = label_width(targets)
    for name, relative_path, directory in targets:
        label = f"{name} ({relative_path})"
        outcome = sync_repository(directory, label, dry_run, assume_yes)
        print(f"{label.ljust(width)} | {outcome.summary}")
        success = success and not outcome.failed
    print()
    return success


def template_drift_files(
    root: Path, manifest: dict[str, object]
) -> tuple[str, ...]:
    replacements = {"PROJECT_NAME": str(manifest["name"])}
    expected = {
        "README.md": readme_text(manifest),
        "AGENTS.md": render_template("AGENTS.md.tmpl", replacements),
        "Makefile": render_template("Makefile.tmpl", replacements),
    }
    return tuple(
        filename
        for filename, content in expected.items()
        if existing_text(root / filename) != content
    )


def templates_doctor(root: Path, manifest: dict[str, object]) -> None:
    drifted = template_drift_files(root, manifest)
    if drifted:
        print(f"Templates: WARNING (drift: {', '.join(drifted)})")
    else:
        print("Templates: PASS")


def beads_doctor(root: Path) -> None:
    if shutil.which("bd") is None:
        raise WorkspaceError("bd is required to validate workspace tracking")
    try:
        result = subprocess.run(
            ["bd", "list", "--limit", "1", "--no-pager", "--readonly"],
            cwd=root,
            capture_output=True,
            check=False,
            text=True,
            timeout=BEADS_HEALTH_TIMEOUT_SECONDS,
        )
    except subprocess.TimeoutExpired as error:
        raise WorkspaceError(
            f"workspace Beads health check timed out after "
            f"{BEADS_HEALTH_TIMEOUT_SECONDS} seconds"
        ) from error
    if result.returncode != 0:
        raise WorkspaceError(
            "workspace Beads store is unusable: "
            f"{diagnostic_output(result.stderr, result.returncode)}"
        )
    print("Beads: PASS")


def doctor_workspace(root: Path) -> None:
    workspace_root = Path(os.path.abspath(root.expanduser()))
    manifest, _readme = load_workspace_manifest(workspace_root)
    print("=== WORKSPACE HEALTH ===")
    print("Workspace: PASS")
    templates_doctor(workspace_root, manifest)
    beads_doctor(workspace_root)
    mgit_doctor(workspace_root, manifest)
    print()


def parser() -> argparse.ArgumentParser:
    command = argparse.ArgumentParser(prog="project-workspace")
    subcommands = command.add_subparsers(dest="command", required=True)
    init = subcommands.add_parser("init", help="initialise a project workspace")
    init.add_argument("name", nargs="?", help="new project name")
    init.add_argument("--repo", type=Path, help="existing Git repository to link")
    init.add_argument("--output", type=Path, help="workspace root directory")
    init.add_argument("--dry-run", action="store_true", help="preview without writing")

    for name, help_text in (
        ("add-repo", "register an existing Git repository"),
        ("add-infrastructure", "register an existing infrastructure reference"),
    ):
        registration = subcommands.add_parser(name, help=help_text)
        registration.add_argument("source", type=Path, help="existing source directory")
        registration.add_argument(
            "--name", help="safe link and manifest name (defaults to source name)"
        )
        registration.add_argument(
            "--workspace", type=Path, default=Path.cwd(), help="workspace root"
        )
        registration.add_argument(
            "--dry-run", action="store_true", help="preview without writing"
        )

    configure = subcommands.add_parser(
        "configure-mgit", help="opt in to installed setup-multirepo-git support"
    )
    configure.add_argument(
        "--workspace", type=Path, default=Path.cwd(), help="workspace root"
    )
    configure.add_argument(
        "--dry-run", action="store_true", help="preview without writing"
    )

    beads_counts = subcommands.add_parser(
        "beads-counts", help="print aggregate workspace Beads counts as JSON"
    )
    beads_counts.add_argument(
        "--workspace", type=Path, default=Path.cwd(), help="workspace root"
    )
    beads_counts.add_argument(
        "--timeout",
        type=float,
        default=STATUS_TIMEOUT_SECONDS,
        help="per-command timeout in seconds",
    )

    status = subcommands.add_parser("status", help="show repository and work status")
    status.add_argument(
        "--workspace", type=Path, default=Path.cwd(), help="workspace root"
    )
    status.add_argument(
        "--section",
        choices=("all", "git", "beads"),
        default="all",
        help="status section to show",
    )

    sync = subcommands.add_parser(
        "sync", help="fetch, integrate, and publish repository work"
    )
    sync.add_argument(
        "--workspace", type=Path, default=Path.cwd(), help="workspace root"
    )
    sync.add_argument(
        "--dry-run", action="store_true", help="preview without integrating or pushing"
    )
    sync.add_argument(
        "--yes",
        action="store_true",
        dest="assume_yes",
        help="rebase diverged branches without prompting",
    )

    doctor = subcommands.add_parser("doctor", help="validate a project workspace")
    doctor.add_argument(
        "--workspace", type=Path, default=Path.cwd(), help="workspace root"
    )
    return command


def main() -> int:
    arguments = parser().parse_args()
    try:
        if arguments.command == "init":
            workspace = workspace_from(arguments)
            create_workspace(workspace, arguments.dry_run)
        elif arguments.command == "doctor":
            doctor_workspace(arguments.workspace)
        elif arguments.command == "beads-counts":
            if not math.isfinite(arguments.timeout) or arguments.timeout <= 0:
                raise WorkspaceError("beads-counts timeout must be greater than zero")
            print_beads_counts(arguments.workspace, arguments.timeout)
        elif arguments.command == "status":
            succeeded = status_workspace(arguments.workspace, arguments.section)
            return 0 if succeeded else 1
        elif arguments.command == "sync":
            succeeded = sync_workspace(
                arguments.workspace, arguments.dry_run, arguments.assume_yes
            )
            return 0 if succeeded else 1
        elif arguments.command == "configure-mgit":
            configure_mgit(arguments)
        else:
            register_source(arguments)
    except (WorkspaceError, OSError, UnicodeError, subprocess.CalledProcessError) as error:
        print(f"ERROR: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
