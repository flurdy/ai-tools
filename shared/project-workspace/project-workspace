class WorkspaceError(RuntimeError):
    """A safe, user-facing workspace creation failure."""


@dataclass(frozen=True)
class GitStatus:
    branch: str
    upstream: str | None
    ahead: int | None
    behind: int | None
    dirty: int


@dataclass(frozen=True)
class GitStatusRow:
    label: str
    status: GitStatus | None = None
    error: str | None = None


@dataclass(frozen=True)
class SyncOutcome:
    summary: str
    failed: bool = False


@dataclass(frozen=True)
class Workspace:
    name: str
    slug: str
    root: Path
    repository: Path | None

    @property
    def repository_link(self) -> Path | None:
        if self.repository is None:
            return None
        return self.root / "repos" / self.slug


@dataclass(frozen=True)
class Registration:
    root: Path
    source: Path
    name: str
    collection: str

    @property
    def relative_path(self) -> str:
        directory = "repos" if self.collection == "repositories" else "infrastructure"
        return f"{directory}/{self.name}"

    @property
    def link(self) -> Path:
        return self.root / self.relative_path


@dataclass(frozen=True)
class RegistrationPlan:
    registration: Registration
    current_manifest: dict[str, object]
    current_manifest_text: str
    updated_manifest: dict[str, object]
    current_readme: str
    updated_readme: str
    link_exists: bool
    unchanged: bool
    mgit_transition: MgitPlan | None


@dataclass(frozen=True)
class MgitPlan:
    root: Path
    services: tuple[str, ...]
    source: Path
    current_config: str | None
    current_script_target: str | None

    @property
    def config_path(self) -> Path:
        return self.root / MGIT_CONFIG

    @property
    def script_path(self) -> Path:
        return self.root / MGIT_SCRIPT

    @property
    def config_text(self) -> str:
        return mgit_config_text(self.services)

    @property
    def script_target(self) -> str:
        return os.path.relpath(self.source, self.script_path.parent)

def slugify(value: str) -> str:
    slug = re.sub(r"[^a-z0-9]+", "-", value.lower()).strip("-")
    if not slug:
        raise WorkspaceError("project name must contain at least one letter or number")
    return slug


def nested(path: Path, parent: Path) -> bool:
    try:
        path.relative_to(parent)
    except ValueError:
        return False
    return True


def workspace_from(arguments: argparse.Namespace) -> Workspace:
    if arguments.repo is None and arguments.name is None:
        raise WorkspaceError("provide a project name or --repo PATH")
    if arguments.repo is not None and arguments.name is not None:
        raise WorkspaceError("provide a project name or --repo PATH, not both")

    repository: Path | None = None
    if arguments.repo is not None:
        repository = arguments.repo.expanduser().resolve()
        if not repository.is_dir():
            raise WorkspaceError(f"repository does not exist: {repository}")
        if not git_is_valid(repository):
            raise WorkspaceError(f"not a Git repository: {repository}")
        name = repository.name
    else:
        name = arguments.name.strip()
        if not name or "\n" in name or "\r" in name:
            raise WorkspaceError("project name must be a non-empty single line")

    slug = slugify(name)
    if arguments.output is not None:
        root = Path(os.path.abspath(arguments.output.expanduser()))
    elif repository is not None:
        root = repository.parent / f"{slug}-workspace"
    else:
        root = Path.cwd() / slug
    root = Path(os.path.abspath(root))

    physical_root = root.resolve()
    if repository is not None and (
        nested(physical_root, repository) or nested(repository, physical_root)
    ):
        raise WorkspaceError("workspace and repository must be separate directories")

    return Workspace(name=name, slug=slug, root=root, repository=repository)


def render_template(name: str, replacements: dict[str, str]) -> str:
    template = (TEMPLATES / name).read_text(encoding="utf-8")
    for marker, value in replacements.items():
        template = template.replace(f"{{{{{marker}}}}}", value)
    return template


def initial_manifest(workspace: Workspace) -> dict[str, object]:
    repositories: list[dict[str, str]] = []
    if workspace.repository is not None:
        repositories.append(
            {
                "name": workspace.slug,
                "path": f"repos/{workspace.slug}",
                "role": "primary",
            }
        )
    return {
        "version": 1,
        "name": workspace.name,
        "repositories": repositories,
        "infrastructure": [],
    }


def manifest_text(data: dict[str, object]) -> str:
    return json.dumps(data, indent=2) + "\n"


def entry_summary(entries: list[dict[str, str]], empty: str) -> str:
    if not entries:
        return empty
    lines = []
    for entry in entries:
        suffix = f" ({entry['role']})" if entry.get("role") else ""
        lines.append(
            f"- `{entry['name']}` — [`{entry['path']}`]({entry['path']}){suffix}"
        )
    return "\n".join(lines)


def readme_replacements(data: dict[str, object]) -> dict[str, str]:
    repositories = data["repositories"]
    infrastructure = data["infrastructure"]
    assert isinstance(repositories, list)
    assert isinstance(infrastructure, list)
    return {
        "PROJECT_NAME": str(data["name"]),
        "REPOSITORIES": entry_summary(
            repositories, "_No repositories are registered yet._"
        ),
        "INFRASTRUCTURE": entry_summary(
            infrastructure, "_No infrastructure references are registered yet._"
        ),
    }


def readme_text(data: dict[str, object]) -> str:
    return render_template("README.md.tmpl", readme_replacements(data))


def legacy_readme_text(data: dict[str, object]) -> str | None:
    infrastructure = data["infrastructure"]
    assert isinstance(infrastructure, list)
    if infrastructure:
        return None
    return render_template("README.md.legacy.tmpl", readme_replacements(data))


def readme_section(collection: str, content: str) -> str:
    return (
        f"<!-- project-workspace:{collection}:start -->\n"
        f"{content}\n"
        f"<!-- project-workspace:{collection}:end -->"
    )


def replace_readme_section(readme: str, collection: str, content: str) -> str:
    start = f"<!-- project-workspace:{collection}:start -->"
    end = f"<!-- project-workspace:{collection}:end -->"
    if readme.count(start) != 1 or readme.count(end) != 1:
        raise WorkspaceError(f"generated workspace README has invalid {collection} markers")
    start_index = readme.index(start)
    end_start = readme.find(end, start_index + len(start))
    if end_start < 0:
        raise WorkspaceError(f"generated workspace README has invalid {collection} markers")
    end_index = end_start + len(end)
    return (
        readme[:start_index]
        + readme_section(collection, content)
        + readme[end_index:]
    )


def readme_matches_manifest(readme: str, data: dict[str, object]) -> bool:
    replacements = readme_replacements(data)
    markers = [
        f"<!-- project-workspace:{collection}:{boundary} -->"
        for collection in ("repositories", "infrastructure")
        for boundary in ("start", "end")
    ]
    if all(readme.count(marker) == 1 for marker in markers):
        expected = readme
        for collection, replacement in (
            ("repositories", replacements["REPOSITORIES"]),
            ("infrastructure", replacements["INFRASTRUCTURE"]),
        ):
            expected = replace_readme_section(expected, collection, replacement)
        return expected == readme
    if any(marker in readme for marker in markers):
        return False
    legacy = legacy_readme_text(data)
    return legacy is not None and readme == legacy


def updated_readme_text(
    readme: str,
    current_manifest: dict[str, object],
    updated_manifest: dict[str, object],
) -> str:
    if readme_matches_manifest(readme, updated_manifest):
        return readme
    if not readme_matches_manifest(readme, current_manifest):
        raise WorkspaceError("generated workspace README has conflicting changes")

    legacy = legacy_readme_text(current_manifest)
    if legacy is not None and readme == legacy:
        return readme_text(updated_manifest)

    replacements = readme_replacements(updated_manifest)
    updated = replace_readme_section(
        readme, "repositories", replacements["REPOSITORIES"]
    )
    return replace_readme_section(
        updated, "infrastructure", replacements["INFRASTRUCTURE"]
    )


def managed_files(workspace: Workspace) -> dict[Path, str]:
    data = initial_manifest(workspace)
    replacements = {"PROJECT_NAME": workspace.name}
    files = {
        workspace.root / ".envrc": render_template(".envrc.tmpl", replacements),
        workspace.root / "README.md": readme_text(data),
        workspace.root / "AGENTS.md": render_template("AGENTS.md.tmpl", replacements),
        workspace.root / "Makefile": render_template("Makefile.tmpl", replacements),
        workspace.root / "workspace.json": manifest_text(data),
    }
    for directory in MANAGED_DIRECTORIES:
        files[workspace.root / directory / ".gitkeep"] = ""
    return files


def existing_text(path: Path) -> str | None:
    if path.is_symlink():
        raise WorkspaceError(f"managed file path is a symlink: {path}")
    if not path.exists():
        return None
    if not path.is_file():
        raise WorkspaceError(f"managed file path is not a file: {path}")
    return path.read_text(encoding="utf-8")


def managed_directory_paths(root: Path) -> list[Path]:
    paths: set[Path] = set()
    for directory in MANAGED_DIRECTORIES:
        path = root
        for part in Path(directory).parts:
            path /= part
            paths.add(path)
    return sorted(paths, key=lambda path: (len(path.parts), str(path)))


def git_worktree_root(path: Path) -> Path | None:
    candidate = path
    while not candidate.exists():
        if candidate == candidate.parent:
            return None
        candidate = candidate.parent
    try:
        result = subprocess.run(
            ["git", "-C", str(candidate), "rev-parse", "--show-toplevel"],
            capture_output=True,
            check=False,
            text=True,
        )
    except FileNotFoundError:
        return None
    if result.returncode != 0 or not result.stdout.strip():
        return None
    return Path(result.stdout.strip()).resolve()


def git_metadata_root(path: Path) -> Path | None:
    candidate = path
    while not candidate.exists():
        if candidate == candidate.parent:
            return None
        candidate = candidate.parent
    while True:
        if os.path.lexists(candidate / ".git"):
            return candidate.resolve()
        if candidate == candidate.parent:
            return None
        candidate = candidate.parent


def git_is_valid(root: Path) -> bool:
    worktree_root = git_worktree_root(root)
    return worktree_root is not None and worktree_root == root.resolve()


def workspace_matches_managed_files(
    files: dict[Path, str], optional_missing: set[Path] | None = None
) -> bool:
    optional_missing = optional_missing or set()
    return all(
        (current := existing_text(path)) == expected
        or (current is None and path in optional_missing)
        for path, expected in files.items()
    )


def preflight(workspace: Workspace, files: dict[Path, str], dry_run: bool) -> bool:
    if workspace.root.is_symlink():
        raise WorkspaceError(f"workspace root must not be a symlink: {workspace.root}")
    if workspace.root.exists() and not workspace.root.is_dir():
        raise WorkspaceError(f"workspace root is not a directory: {workspace.root}")

    for path in managed_directory_paths(workspace.root):
        if path.is_symlink():
            raise WorkspaceError(f"managed directory must not be a symlink: {path}")
        if path.exists() and not path.is_dir():
            raise WorkspaceError(f"managed directory path is not a directory: {path}")

    git_path = workspace.root / ".git"
    if git_path.is_symlink():
        raise WorkspaceError(f"workspace Git metadata must not be a symlink: {git_path}")
    recovery_ready = workspace_matches_managed_files(
        files, {workspace.root / ".envrc"}
    )
    worktree_root = (
        git_metadata_root(workspace.root)
        if dry_run
        else git_worktree_root(workspace.root)
    )
    if worktree_root is not None and worktree_root != workspace.root.resolve():
        raise WorkspaceError(
            f"refusing to scaffold inside an existing Git work tree: {workspace.root}"
        )
    if os.path.lexists(git_path) and not recovery_ready:
        raise WorkspaceError(
            f"refusing to scaffold inside an existing Git repository: {workspace.root}"
        )
    if worktree_root == workspace.root.resolve() and not recovery_ready:
        raise WorkspaceError(
            f"refusing to scaffold inside an existing Git repository: {workspace.root}"
        )

    beads_path = workspace.root / ".beads"
    if beads_path.is_symlink():
        raise WorkspaceError(f"workspace Beads metadata must not be a symlink: {beads_path}")
    if beads_path.exists() and not beads_path.is_dir():
        raise WorkspaceError(f"workspace Beads metadata is not a directory: {beads_path}")

    conflicts = [
        path
        for path, expected in files.items()
        if (current := existing_text(path)) is not None and current != expected
    ]

    link = workspace.repository_link
    if link is not None and os.path.lexists(link):
        if (
            not link.is_symlink()
            or os.path.isabs(os.readlink(link))
            or link.resolve() != workspace.repository
        ):
            conflicts.append(link)

    if conflicts:
        details = "\n".join(f"  - {path}" for path in conflicts)
        raise WorkspaceError(f"refusing to overwrite existing workspace content:\n{details}")

    if dry_run:
        return os.path.lexists(git_path)
    if shutil.which("git") is None:
        raise WorkspaceError("git is required to initialise or validate the workspace")
    if shutil.which("bd") is None:
        raise WorkspaceError("bd is required to initialise project-level tracking")
    if not os.path.lexists(git_path):
        return False
    return worktree_root == workspace.root.resolve()


def relative(path: Path, root: Path) -> str:
    try:
        return str(path.relative_to(root))
    except ValueError:
        return str(path)


def print_plan(
    workspace: Workspace, files: dict[Path, str], git_ready: bool
) -> None:
    print(f"Workspace: {workspace.root}")
    for directory in MANAGED_DIRECTORIES:
        path = workspace.root / directory
        action = "KEEP" if path.is_dir() else "CREATE"
        print(f"{action} directory {relative(path, workspace.root)}")
    for path, expected in files.items():
        current = existing_text(path)
        action = "UNCHANGED" if current == expected else "CREATE"
        print(f"{action} file {relative(path, workspace.root)}")
    if workspace.repository_link is not None:
        action = "UNCHANGED" if os.path.lexists(workspace.repository_link) else "CREATE"
        print(
            f"{action} link {relative(workspace.repository_link, workspace.root)}"
            f" -> {workspace.repository}"
        )
    if not git_ready:
        print("RUN git init -b main")
    print("RUN bd init --init-if-missing --non-interactive --skip-agents")


def create_workspace(workspace: Workspace, dry_run: bool) -> None:
    files = managed_files(workspace)
    git_ready = preflight(workspace, files, dry_run)
    if dry_run:
        print_plan(workspace, files, git_ready)
        return

    workspace.root.mkdir(parents=True, exist_ok=True)
    for directory in MANAGED_DIRECTORIES:
        (workspace.root / directory).mkdir(parents=True, exist_ok=True)
    for path, content in files.items():
        if not path.exists():
            path.write_text(content, encoding="utf-8")

    if not git_ready:
        subprocess.run(["git", "init", "-b", "main"], cwd=workspace.root, check=True)
    subprocess.run(
        ["bd", "init", "--init-if-missing", "--non-interactive", "--skip-agents"],
        cwd=workspace.root,
        check=True,
    )

    if workspace.repository_link is not None and not os.path.lexists(workspace.repository_link):
        target = os.path.relpath(workspace.repository, workspace.repository_link.parent)
        workspace.repository_link.symlink_to(target, target_is_directory=True)

    print(f"Initialised workspace: {workspace.root}")


def registration_name(value: str) -> str:
    if value != slugify(value):
        raise WorkspaceError(
            "registration name must use lowercase letters, numbers, and single hyphens"
        )
    return value


def registration_from(arguments: argparse.Namespace) -> Registration:
    root = Path(os.path.abspath(arguments.workspace.expanduser()))
    source_input = Path(os.path.abspath(arguments.source.expanduser()))
    if source_input.is_symlink():
        raise WorkspaceError(f"registration source must not be a symlink: {source_input}")
    if not source_input.is_dir():
        raise WorkspaceError(f"registration source does not exist: {source_input}")

    source = source_input.resolve()
    collection = (
        "repositories" if arguments.command == "add-repo" else "infrastructure"
    )
    if collection == "repositories" and not git_is_valid(source):
        raise WorkspaceError(f"not a Git repository: {source}")

    physical_root = root.resolve()
    if nested(source, physical_root) or nested(physical_root, source):
        raise WorkspaceError("workspace and registration source must be separate directories")

    name = (
        registration_name(arguments.name)
        if arguments.name is not None
        else slugify(source.name)
    )
    return Registration(
        root=root,
        source=source,
        name=name,
        collection=collection,
    )


def validate_manifest(
    data: object, root: Path, allowed_orphan: Path | None = None
) -> dict[str, object]:
    if not isinstance(data, dict):
        raise WorkspaceError("workspace.json must contain a JSON object")
    name = data.get("name")
    if (
        data.get("version") != 1
        or not isinstance(name, str)
        or not name.strip()
        or "\n" in name
        or "\r" in name
    ):
        raise WorkspaceError("workspace.json is not a supported project workspace manifest")

    physical_root = root.resolve()
    names: set[str] = set()
    targets: set[Path] = set()
    expected_links: set[Path] = set()
    for collection, directory in (
        ("repositories", "repos"),
        ("infrastructure", "infrastructure"),
    ):
        entries = data.get(collection)
        if not isinstance(entries, list):
            raise WorkspaceError(f"workspace.json field must be a list: {collection}")
        for entry in entries:
            if not isinstance(entry, dict):
                raise WorkspaceError(f"invalid {collection} entry in workspace.json")
            entry_name = entry.get("name")
            path = entry.get("path")
            if not isinstance(entry_name, str) or not isinstance(path, str):
                raise WorkspaceError(f"invalid {collection} entry in workspace.json")
            registration_name(entry_name)
            if entry_name in names:
                raise WorkspaceError(
                    f"duplicate registration name in workspace.json: {entry_name}"
                )
            names.add(entry_name)
            if path != f"{directory}/{entry_name}":
                raise WorkspaceError(f"unsafe registered path in workspace.json: {path}")
            if collection == "repositories" and entry.get("role") not in (
                "primary",
                "service",
            ):
                raise WorkspaceError(
                    f"repository role is invalid in workspace.json: {entry_name}"
                )

            link = root / path
            expected_links.add(link)
            if not link.is_symlink() or os.path.isabs(os.readlink(link)):
                raise WorkspaceError(
                    f"registered path is not a safe relative symlink: {path}"
                )
            if not link.exists() or not link.resolve().is_dir():
                raise WorkspaceError(f"registered path is broken: {path}")
            target = link.resolve()
            if nested(target, physical_root) or nested(physical_root, target):
                raise WorkspaceError(
                    f"workspace and registered source must be separate: {path}"
                )
            if target in targets:
                raise WorkspaceError(f"source is registered more than once: {target}")
            targets.add(target)
            if collection == "repositories" and not git_is_valid(target):
                raise WorkspaceError(
                    f"registered repository is not a Git repository: {path}"
                )

    for directory in (root / "repos", root / "infrastructure"):
        for child in directory.iterdir():
            if child.name == ".gitkeep" or child in expected_links:
                continue
            if allowed_orphan is not None and child == allowed_orphan:
                continue
            raise WorkspaceError(f"unregistered workspace path: {child.relative_to(root)}")
    return data


def load_workspace_data(
    root: Path, allowed_orphan: Path | None = None
) -> tuple[dict[str, object], str]:
    if root.is_symlink():
        raise WorkspaceError(f"workspace root must not be a symlink: {root}")
    if not root.is_dir():
        raise WorkspaceError(f"workspace does not exist: {root}")

    git_path = root / ".git"
    beads_path = root / ".beads"
    if git_path.is_symlink() or not git_is_valid(root):
        raise WorkspaceError(f"not an initialised project workspace: {root}")
    if beads_path.is_symlink() or not beads_path.is_dir():
        raise WorkspaceError(f"not an initialised project workspace: {root}")
    for path in managed_directory_paths(root):
        if path.is_symlink() or not path.is_dir():
            raise WorkspaceError(f"workspace directory is unsafe or missing: {path}")
    for filename in ("README.md", "AGENTS.md", "Makefile"):
        path = root / filename
        if existing_text(path) is None:
            raise WorkspaceError(f"workspace file is missing: {path}")

    manifest_path = root / "workspace.json"
    raw_manifest = existing_text(manifest_path)
    if raw_manifest is None:
        raise WorkspaceError(f"workspace.json is missing: {manifest_path}")
    try:
        data = json.loads(raw_manifest)
    except json.JSONDecodeError as error:
        raise WorkspaceError(f"workspace.json is invalid: {error}") from error
    return validate_manifest(data, root, allowed_orphan), raw_manifest


def load_workspace_manifest(root: Path) -> tuple[dict[str, object], str]:
    manifest_data, _raw_manifest = load_workspace_data(root)
    readme_path = root / "README.md"
    current_readme = existing_text(readme_path)
    assert current_readme is not None
    if not readme_matches_manifest(current_readme, manifest_data):
        raise WorkspaceError(f"generated workspace README has conflicting changes: {readme_path}")
    return manifest_data, current_readme


def mgit_config_text(services: tuple[str, ...]) -> str:
    return (
        "# Multi-repo workspace configuration\n"
        "# Presence of this file marks the project root for mgit\n"
        f"services={','.join(services)}\n"
    )


def mgit_source_in(root: Path) -> Path | None:
    skill = root.expanduser() / MGIT_SKILL_NAME
    source = skill / "scripts" / "mgit"
    resources = (
        skill / "SKILL.md",
        skill / "templates" / "permissions.json",
        skill / "templates" / "AGENTS-MGIT.md",
    )
    if (
        source.is_file()
        and os.access(source, os.X_OK)
        and all(resource.is_file() for resource in resources)
    ):
        return source.resolve()
    return None


def installed_mgit_source() -> Path:
    configured_root = os.environ.get("SKILLS_DIR") or None
    if configured_root is not None:
        roots = (Path(configured_root),)
    else:
        codex_home = Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex")
        claude_home = Path(os.environ.get("CLAUDE_HOME") or Path.home() / ".claude")
        roots = (
            codex_home / "skills",
            claude_home / "skills",
            Path.home() / ".agents" / "skills",
        )
    for root in roots:
        source = mgit_source_in(root)
        if source is not None:
            return source
    raise WorkspaceError(
        "setup-multirepo-git skill is not installed; install it before configuring mgit"
    )


def mgit_services(manifest: dict[str, object]) -> tuple[str, ...]:
    repositories = manifest["repositories"]
    assert isinstance(repositories, list)
    services = tuple(str(entry["path"]) for entry in repositories)
    if not services:
        raise WorkspaceError("workspace has no registered repositories for mgit")
    return services


def current_mgit_script_target(root: Path) -> str | None:
    script = root / MGIT_SCRIPT
    if script.parent.is_symlink() or (script.parent.exists() and not script.parent.is_dir()):
        raise WorkspaceError(f"workspace scripts directory is unsafe: {script.parent}")
    if not os.path.lexists(script):
        return None
    if not script.is_symlink() or os.path.isabs(os.readlink(script)):
        raise WorkspaceError(f"workspace mgit script is unsafe: {script}")
    return os.readlink(script)


def mgit_plan(root: Path) -> MgitPlan:
    manifest, _readme = load_workspace_manifest(root)
    config_path = root / MGIT_CONFIG
    current_config = existing_text(config_path)
    source = installed_mgit_source()
    script_target = current_mgit_script_target(root)
    plan = MgitPlan(
        root=root,
        services=mgit_services(manifest),
        source=source,
        current_config=current_config,
        current_script_target=script_target,
    )
    if current_config is not None and current_config != plan.config_text:
        raise WorkspaceError(f"existing mgit configuration conflicts: {config_path}")
    if script_target is not None and (
        script_target != plan.script_target or plan.script_path.resolve() != source
    ):
        raise WorkspaceError(f"existing mgit script conflicts: {plan.script_path}")
    return plan


def print_mgit_plan(plan: MgitPlan) -> None:
    print(f"Workspace: {plan.root}")
    print("Services: " + ", ".join(plan.services))
    print(
        f"{'UNCHANGED' if plan.current_config == plan.config_text else 'CREATE'} "
        f"file {MGIT_CONFIG}"
    )
    print(
        f"{'UNCHANGED' if plan.current_script_target == plan.script_target else 'CREATE'} "
        f"link {MGIT_SCRIPT} -> {plan.source}"
    )
    print(f"{MGIT_CONFIG}:")
    print(plan.config_text, end="")
    print("VERIFY ./scripts/mgit status root")
    print(f"VERIFY ./scripts/mgit status {plan.services[0]}")


def diagnostic_output(value: str, returncode: int) -> str:
    safe = "".join(
        character
        if character in "\n\t" or character.isprintable()
        else "?"
        for character in value
    ).strip()
    if not safe:
        return f"exit status {returncode}"
    if len(safe) > DIAGNOSTIC_OUTPUT_LIMIT:
        return safe[:DIAGNOSTIC_OUTPUT_LIMIT].rstrip() + "\n[output truncated]"
    return safe


def verify_mgit(plan: MgitPlan, service: str | None = None) -> None:
    for target in ("root", service or plan.services[0]):
        try:
            subprocess.run(
                ["./scripts/mgit", "status", target],
                cwd=plan.root,
                capture_output=True,
                check=True,
                text=True,
            )
        except subprocess.CalledProcessError as error:
            raise WorkspaceError(
                f"mgit verification failed for {target}: "
                f"{diagnostic_output(error.stderr or '', error.returncode)}"
            ) from error


def apply_mgit(plan: MgitPlan, dry_run: bool) -> None:
    if dry_run:
        print_mgit_plan(plan)
        return
    if (
        existing_text(plan.config_path) != plan.current_config
        or current_mgit_script_target(plan.root) != plan.current_script_target
    ):
        raise WorkspaceError("workspace changed after mgit preflight")

    script_parent_created = False
    script_created = False
    config_changed = False
    try:
        if not plan.script_path.parent.exists():
            plan.script_path.parent.mkdir()
            script_parent_created = True
        if plan.current_script_target is None:
            plan.script_path.symlink_to(plan.script_target)
            script_created = True
        if plan.current_config != plan.config_text:
            atomic_write_text(plan.config_path, plan.config_text)
            config_changed = True
        verify_mgit(plan)
    except BaseException:
        if config_changed:
            if plan.current_config is None:
                plan.config_path.unlink(missing_ok=True)
            elif existing_text(plan.config_path) != plan.current_config:
                atomic_write_text(plan.config_path, plan.current_config)
        if script_created:
            plan.script_path.unlink(missing_ok=True)
        if script_parent_created:
            plan.script_path.parent.rmdir()
        raise
    print("Configured mgit")


def configure_mgit(arguments: argparse.Namespace) -> None:
    root = Path(os.path.abspath(arguments.workspace.expanduser()))
    apply_mgit(mgit_plan(root), arguments.dry_run)


def configured_mgit_plan(
    root: Path, manifest: dict[str, object]
) -> MgitPlan | None:
    config_path = root / MGIT_CONFIG
    script_path = root / MGIT_SCRIPT
    config_exists = os.path.lexists(config_path)
    script_exists = os.path.lexists(script_path)
    if not config_exists and not script_exists:
        return None
    if not config_exists or not script_exists:
        raise WorkspaceError("mgit configuration is incomplete")

    source = installed_mgit_source()
    plan = MgitPlan(
        root=root,
        services=mgit_services(manifest),
        source=source,
        current_config=existing_text(config_path),
        current_script_target=current_mgit_script_target(root),
    )
    if plan.current_config != plan.config_text:
        raise WorkspaceError(f"existing mgit configuration conflicts: {config_path}")
    if (
        plan.current_script_target != plan.script_target
        or script_path.resolve() != source
    ):
        raise WorkspaceError(f"existing mgit script conflicts: {script_path}")
    return plan


def mgit_doctor(root: Path, manifest: dict[str, object]) -> None:
    plan = configured_mgit_plan(root, manifest)
    if plan is None:
        print("Mgit: UNCONFIGURED")
        return
    verify_mgit(plan)
    print("Mgit: PASS")


def registration_plan(registration: Registration) -> RegistrationPlan:
    manifest_data, current_manifest_text = load_workspace_data(
        registration.root, registration.link
    )
    current_readme = existing_text(registration.root / "README.md")
    assert current_readme is not None
    repositories = manifest_data["repositories"]
    infrastructure = manifest_data["infrastructure"]
    assert isinstance(repositories, list)
    assert isinstance(infrastructure, list)
    current_mgit = (
        configured_mgit_plan(registration.root, manifest_data)
        if registration.collection == "repositories"
        else None
    )

    matching_entry: dict[str, object] | None = None
    for collection, entries in (
        ("repositories", repositories),
        ("infrastructure", infrastructure),
    ):
        for entry in entries:
            assert isinstance(entry, dict)
            name = entry["name"]
            path = entry["path"]
            link = registration.root / str(path)
            if name == registration.name:
                if collection != registration.collection:
                    raise WorkspaceError(
                        f"duplicate registration name in another collection: {registration.name}"
                    )
                matching_entry = entry
            if link.resolve() == registration.source and name != registration.name:
                raise WorkspaceError(f"source is already registered as: {name}")

    expected_target = os.path.relpath(registration.source, registration.link.parent)
    if matching_entry is not None:
        if registration.link.resolve() != registration.source:
            raise WorkspaceError(f"duplicate registration name: {registration.name}")
        if (
            not registration.link.is_symlink()
            or os.readlink(registration.link) != expected_target
        ):
            raise WorkspaceError(
                f"manifest/link conflict for registration: {registration.name}"
            )
        if not readme_matches_manifest(current_readme, manifest_data):
            readme_path = registration.root / "README.md"
            raise WorkspaceError(
                f"generated workspace README has conflicting changes: {readme_path}"
            )
        return RegistrationPlan(
            registration=registration,
            current_manifest=manifest_data,
            current_manifest_text=current_manifest_text,
            updated_manifest=manifest_data,
            current_readme=current_readme,
            updated_readme=current_readme,
            link_exists=True,
            unchanged=True,
            mgit_transition=None,
        )

    link_exists = os.path.lexists(registration.link)
    if link_exists and (
        not registration.link.is_symlink()
        or os.path.isabs(os.readlink(registration.link))
        or os.readlink(registration.link) != expected_target
        or registration.link.resolve() != registration.source
    ):
        raise WorkspaceError(f"registration link already exists: {registration.link}")

    updated_manifest = json.loads(json.dumps(manifest_data))
    updated_entries = updated_manifest[registration.collection]
    assert isinstance(updated_entries, list)
    entry: dict[str, str] = {
        "name": registration.name,
        "path": registration.relative_path,
    }
    if registration.collection == "repositories":
        entry["role"] = "primary" if not repositories else "service"
    updated_entries.append(entry)
    try:
        updated_readme = updated_readme_text(
            current_readme, manifest_data, updated_manifest
        )
    except WorkspaceError as error:
        readme_path = registration.root / "README.md"
        raise WorkspaceError(
            f"generated workspace README has conflicting changes: {readme_path}"
        ) from error
    if readme_matches_manifest(current_readme, updated_manifest) and not link_exists:
        raise WorkspaceError("workspace README and manifest are inconsistent")
    mgit_transition = None
    if current_mgit is not None:
        mgit_transition = MgitPlan(
            root=current_mgit.root,
            services=mgit_services(updated_manifest),
            source=current_mgit.source,
            current_config=current_mgit.current_config,
            current_script_target=current_mgit.current_script_target,
        )
    return RegistrationPlan(
        registration=registration,
        current_manifest=manifest_data,
        current_manifest_text=current_manifest_text,
        updated_manifest=updated_manifest,
        current_readme=current_readme,
        updated_readme=updated_readme,
        link_exists=link_exists,
        unchanged=False,
        mgit_transition=mgit_transition,
    )


def atomic_write_text(path: Path, content: str) -> None:
    descriptor, temporary_name = tempfile.mkstemp(
        dir=path.parent, prefix=f".{path.name}.", suffix=".tmp"
    )
    temporary = Path(temporary_name)
    mode = path.stat().st_mode if path.exists() else 0o644
    try:
        os.fchmod(descriptor, mode)
        stream = os.fdopen(descriptor, "w", encoding="utf-8")
        descriptor = -1
        with stream:
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        temporary.unlink(missing_ok=True)


def print_registration_plan(plan: RegistrationPlan) -> None:
    registration = plan.registration
    print(f"Workspace: {registration.root}")
    link_action = "UNCHANGED" if plan.link_exists else "CREATE"
    print(f"{link_action} link {registration.relative_path} -> {registration.source}")
    readme_action = "UNCHANGED" if plan.current_readme == plan.updated_readme else "UPDATE"
    print(f"{readme_action} file README.md")
    print(f"{'UNCHANGED' if plan.unchanged else 'UPDATE'} file workspace.json")
    if plan.mgit_transition is not None:
        print(f"UPDATE file {MGIT_CONFIG}")
        print(f"VERIFY ./scripts/mgit status {registration.relative_path}")


def apply_registration(plan: RegistrationPlan, dry_run: bool) -> None:
    if dry_run:
        print_registration_plan(plan)
        return
    registration = plan.registration
    if plan.unchanged:
        print(f"Registration unchanged: {registration.relative_path}")
        return

    target = os.path.relpath(registration.source, registration.link.parent)
    readme_path = registration.root / "README.md"
    manifest_path = registration.root / "workspace.json"
    mgit = plan.mgit_transition
    if (
        existing_text(readme_path) != plan.current_readme
        or existing_text(manifest_path) != plan.current_manifest_text
        or (
            mgit is not None
            and (
                existing_text(mgit.config_path) != mgit.current_config
                or current_mgit_script_target(registration.root)
                != mgit.current_script_target
            )
        )
    ):
        raise WorkspaceError("workspace changed after registration preflight")
    if not registration.source.is_dir() or (
        registration.collection == "repositories"
        and not git_is_valid(registration.source)
    ):
        raise WorkspaceError("registration source changed after preflight")

    link_created = False
    readme_changed = False
    mgit_changed = False
    try:
        if not plan.link_exists:
            registration.link.symlink_to(target, target_is_directory=True)
            link_created = True
        if plan.current_readme != plan.updated_readme:
            atomic_write_text(readme_path, plan.updated_readme)
            readme_changed = True
        if mgit is not None and mgit.current_config != mgit.config_text:
            atomic_write_text(mgit.config_path, mgit.config_text)
            mgit_changed = True
        atomic_write_text(manifest_path, manifest_text(plan.updated_manifest))
        if mgit is not None:
            verify_mgit(mgit, registration.relative_path)
    except BaseException:
        if link_created:
            registration.link.unlink(missing_ok=True)
        if readme_changed and existing_text(readme_path) != plan.current_readme:
            atomic_write_text(readme_path, plan.current_readme)
        if mgit_changed and existing_text(mgit.config_path) != mgit.current_config:
            assert mgit.current_config is not None
            atomic_write_text(mgit.config_path, mgit.current_config)
        if existing_text(manifest_path) != plan.current_manifest_text:
            atomic_write_text(manifest_path, plan.current_manifest_text)
        raise
    print(f"Registered {registration.relative_path} -> {registration.source}")


def register_source(arguments: argparse.Namespace) -> None:
    registration = registration_from(arguments)
    plan = registration_plan(registration)
    apply_registration(plan, arguments.dry_run)


def status_targets(
    root: Path, manifest: dict[str, object]
) -> list[tuple[str, str, Path]]:
    repositories = manifest["repositories"]
    assert isinstance(repositories, list)
    return [("workspace", ".", root)] + [
        (
            str(repository["name"]),
            str(repository["path"]),
            root / str(repository["path"]),
        )
        for repository in repositories
    ]


def label_width(targets: list[tuple[str, str, Path]]) -> int:
    return max((len(f"{name} ({path})") for name, path, _ in targets), default=0)


def run_repository_command(
    command: list[str], cwd: Path, timeout: float = STATUS_TIMEOUT_SECONDS
) -> tuple[subprocess.CompletedProcess[str] | None, str | None]:
    try:
        result = subprocess.run(
            command,
            cwd=cwd,
            capture_output=True,
            check=False,
            text=True,
            timeout=timeout,
        )
    except subprocess.TimeoutExpired:
        return None, f"timed out after {timeout} seconds"
    except OSError as error:
        return None, str(error)
    if result.returncode != 0:
        return None, diagnostic_output(
            result.stderr or result.stdout, result.returncode
        )
    return result, None


def run_repository_command_before(
    command: list[str], cwd: Path, deadline: float, timeout: float
) -> tuple[subprocess.CompletedProcess[str] | None, str | None]:
    remaining = deadline - monotonic()
    if remaining <= 0:
        return None, f"timed out after {timeout} seconds"
    result, error = run_repository_command(command, cwd, remaining)
    if error is not None and error.startswith("timed out after "):
        return None, f"timed out after {timeout} seconds"
    return result, error


def parse_git_status(output: str) -> GitStatus:
    branch = "?"
    upstream: str | None = None
    ahead: int | None = None
    behind: int | None = None
    dirty = 0
    for line in output.splitlines():
        if line.startswith("# branch.head "):
            branch = line.removeprefix("# branch.head ")
        elif line.startswith("# branch.upstream "):
            upstream = line.removeprefix("# branch.upstream ")
        elif line.startswith("# branch.ab "):
            match = re.fullmatch(r"\+(\d+) -(\d+)", line.removeprefix("# branch.ab "))
            if match is not None:
                ahead, behind = (int(value) for value in match.groups())
        elif not line.startswith("# "):
            dirty += 1
    return GitStatus(branch, upstream, ahead, behind, dirty)


def repository_git_status(directory: Path) -> tuple[GitStatus | None, str | None]:
    result, error = run_repository_command(
        ["git", "status", "--porcelain=v2", "--branch"], directory
    )
    if error is not None:
        return None, error
    assert result is not None
    return parse_git_status(result.stdout), None


def repository_git_common_directory(
    directory: Path,
) -> tuple[Path | None, str | None]:
    result, error = run_repository_command(
        ["git", "rev-parse", "--git-common-dir"], directory
    )
    if error is not None:
        return None, error
    assert result is not None
    lines = result.stdout.splitlines()
    if len(lines) != 1 or not lines[0]:
        return None, "invalid git common directory"
    common_directory = Path(lines[0])
    if not common_directory.is_absolute():
        common_directory = directory / common_directory
    try:
        return common_directory.resolve(), None
    except OSError as error:
        return None, str(error)


def repository_worktrees(directory: Path) -> tuple[list[Path], str | None]:
    result, error = run_repository_command(
        ["git", "worktree", "list", "--porcelain"], directory
    )
    if error is not None:
        return [], error
    assert result is not None
    worktrees: list[Path] = []
    for line in result.stdout.splitlines():
        if not line.startswith("worktree "):
            continue
        path = Path(line.removeprefix("worktree "))
        if not path.is_absolute():
            path = directory / path
        try:
            resolved = path.resolve()
        except OSError as error:
            return [], str(error)
        if resolved not in worktrees:
            worktrees.append(resolved)
    if not worktrees:
        return [], "invalid git worktree list: no worktree entries"
    if len(worktrees) > STATUS_WORKTREE_LIMIT:
        return [], (
            f"worktree limit exceeded ({len(worktrees)} > {STATUS_WORKTREE_LIMIT})"
        )
    return worktrees, None


def actionable_worktree(status: GitStatus) -> bool:
    if status.dirty or status.upstream is None:
        return True
    if status.ahead is None or status.behind is None:
        return True
    return status.ahead > 0


def git_status_rows(
    targets: list[tuple[str, str, Path]],
) -> list[GitStatusRow]:
    rows: list[GitStatusRow] = []
    registered_paths = {directory.resolve() for _, _, directory in targets}
    inspected_common_directories: set[Path] = set()
    for name, relative_path, directory in targets:
        label = f"{name} ({relative_path})"
        summary, error = repository_git_status(directory)
        rows.append(GitStatusRow(label, summary, error))

        common_directory, common_error = repository_git_common_directory(directory)
        if common_error is not None:
            rows.append(
                GitStatusRow(
                    f"{name} worktrees ({relative_path})", error=common_error
                )
            )
            continue
        assert common_directory is not None
        if common_directory in inspected_common_directories:
            continue
        inspected_common_directories.add(common_directory)

        worktrees, worktree_error = repository_worktrees(directory)
        if worktree_error is not None:
            rows.append(
                GitStatusRow(
                    f"{name} worktrees ({relative_path})", error=worktree_error
                )
            )
            continue
        for worktree in worktrees:
            if worktree in registered_paths:
                continue
            worktree_status, status_error = repository_git_status(worktree)
            worktree_label = f"{name} worktree ({worktree})"
            if status_error is not None:
                rows.append(GitStatusRow(worktree_label, error=status_error))
            elif worktree_status is not None and actionable_worktree(worktree_status):
                rows.append(GitStatusRow(worktree_label, worktree_status))
    return rows


def display_count(value: int | None) -> str:
    return "—" if value is None else str(value)


def git_status(root: Path, manifest: dict[str, object]) -> bool:
    print("=== GIT STATUS ===")
    rows = git_status_rows(status_targets(root, manifest))
    width = max((len(row.label) for row in rows), default=0)
    success = True
    for row in rows:
        label = row.label.ljust(width)
        if row.error is not None:
            print(f"{label} | ERROR: {row.error}")
            success = False
            continue
        assert row.status is not None
        print(
            f"{label} | branch {row.status.branch} | "
            f"upstream {row.status.upstream or '—'} | "
            f"ahead {display_count(row.status.ahead)} | "
            f"behind {display_count(row.status.behind)} | dirty {row.status.dirty}"
        )
    print()
    return success


def load_status_issues(
    directory: Path, arguments: list[str]
) -> tuple[list[dict[str, object]], str | None]:
    result, error = run_repository_command(
        [
            "bd",
            "list",
            *arguments,
            "--json",
            "--limit",
            str(STATUS_ISSUE_LIMIT + 1),
            "--no-pager",
            "--readonly",
        ],
        directory,
    )
    if error is not None:
        return [], error
    assert result is not None
    try:
        issues = json.loads(result.stdout)
    except json.JSONDecodeError as error:
        return [], f"invalid bd JSON: {error}"
    if not isinstance(issues, list) or not all(
        isinstance(issue, dict) for issue in issues
    ):
        return [], "invalid bd JSON: expected an issue list"
    return issues, None


def parse_beads_count_source(
    issues_output: str, blocked_output: str
) -> tuple[list[int], int, int] | None:
    try:
        issues = json.loads(issues_output)
        blocked = json.loads(blocked_output)
    except json.JSONDecodeError:
        return None
    if not isinstance(issues, list) or not isinstance(blocked, list):
        return None
    if not all(isinstance(issue, dict) for issue in blocked):
        return None

    open_by_priority = [0, 0, 0, 0, 0]
    in_progress = 0
    for issue in issues:
        if not isinstance(issue, dict) or not isinstance(issue.get("status"), str):
            return None
        status = issue["status"]
        if status == "in_progress":
            in_progress += 1
        elif status == "open":
            priority = issue.get("priority")
            if (
                not isinstance(priority, int)
                or isinstance(priority, bool)
                or priority < 0
                or priority > 4
            ):
                return None
            open_by_priority[priority] += 1
    return open_by_priority, in_progress, len(blocked)


def beads_count_payload(
    root: Path, manifest: dict[str, object], timeout: float
) -> dict[str, object]:
    targets = status_targets(root, manifest)
    diagnostics: list[str] = []
    outputs: dict[
        int,
        dict[str, tuple[subprocess.CompletedProcess[str] | None, str | None]],
    ] = {}
    futures: list[
        tuple[
            int,
            str,
            Future[tuple[subprocess.CompletedProcess[str] | None, str | None]],
        ]
    ] = []

    commands = (
        ("issues", ["bd", "list", "--json", "--limit", "0", "--no-pager", "--readonly"]),
        ("blocked", ["bd", "blocked", "--json", "--readonly"]),
    )
    request_count = sum(
        2 for _, _, directory in targets if (directory / ".beads").is_dir()
    )
    deadline = monotonic() + timeout
    with ThreadPoolExecutor(
        max_workers=max(1, min(request_count, STATUS_COUNT_WORKERS))
    ) as executor:
        for index, (name, relative_path, directory) in enumerate(targets):
            label = f"{name} ({relative_path})"
            if not (directory / ".beads").is_dir():
                diagnostics.append(f"{label}: Beads store is not initialized")
                continue
            outputs[index] = {}
            for kind, command in commands:
                futures.append(
                    (
                        index,
                        kind,
                        executor.submit(
                            run_repository_command_before,
                            command,
                            directory,
                            deadline,
                            timeout,
                        ),
                    )
                )
        for index, kind, future in futures:
            outputs[index][kind] = future.result()

    open_by_priority = [0, 0, 0, 0, 0]
    in_progress = 0
    blocked = 0
    successful_sources = 0
    for index, (name, relative_path, _directory) in enumerate(targets):
        source = outputs.get(index)
        if source is None:
            continue
        label = f"{name} ({relative_path})"
        issues_result, issues_error = source["issues"]
        blocked_result, blocked_error = source["blocked"]
        error = issues_error or blocked_error
        if error is not None:
            diagnostics.append(f"{label}: {error}")
            continue
        assert issues_result is not None and blocked_result is not None
        counts = parse_beads_count_source(issues_result.stdout, blocked_result.stdout)
        if counts is None:
            diagnostics.append(f"{label}: invalid bd JSON: expected countable issue lists")
            continue
        source_priorities, source_in_progress, source_blocked = counts
        open_by_priority = [
            total + source_count
            for total, source_count in zip(open_by_priority, source_priorities)
        ]
        in_progress += source_in_progress
        blocked += source_blocked
        successful_sources += 1

    return {
        "version": 1,
        "openByPriority": open_by_priority,
        "inProgress": in_progress,
        "blocked": blocked,
        "successfulSources": successful_sources,
        "unavailableSources": len(diagnostics),
        "diagnostics": diagnostics,
    }


